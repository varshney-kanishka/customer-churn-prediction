# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Virtual environments
.venv/
venv/

# Secrets
.env
.env.*

# Jupyter
.ipynb_checkpoints/

# Local databases
*.db
*.sqlite
*.sqlite3

# Data (raw dataset is never committed; folders are kept via .gitkeep)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model artifacts
models/*
!models/.gitkeep

# Generated outputs (folders kept; final report in /reports is tracked)
outputs/figures/*
outputs/reports/*
outputs/metrics/*
outputs/predictions/*
!outputs/figures/.gitkeep
!outputs/reports/.gitkeep
!outputs/metrics/.gitkeep
!outputs/predictions/.gitkeep

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
